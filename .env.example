# Copy to .env.local and fill in. Never commit .env.local.
#
# Everything here is NEXT_PUBLIC_, which means it is compiled into the
# JavaScript bundle and visible to anyone who opens devtools. Only put values
# here that are safe to publish. Secrets belong in the backend.

# Base URL of the theo-genesis-backend service. No trailing slash.
#   local:      http://localhost:3000
#   deployed:   https://your-backend.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Google Places / Maps JavaScript API key, used by the Restaurant Info panel.
#
# This key is served to the browser and cannot be hidden. Restrict it in the
# Google Cloud console before using it:
#   - HTTP referrer restriction -> only your own origins
#   - API restriction -> Places API and Maps JavaScript API only
#   - a billing quota cap
# An unrestricted key in a public repo can be used by anyone, billed to you.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Google Places ID for the demo restaurant.
NEXT_PUBLIC_ELEVEN_MADISON_PARK_PLACE_ID=

# Email of a Google Calendar to preview in the Calendar panel (CalendarConsole).
# Use a calendar you're fine making world-readable via Google's embed widget —
# not a personal one. Leave blank to show a placeholder instead of an iframe.
NEXT_PUBLIC_DEMO_CALENDAR_EMAIL=
